ARCHE_PRIVACY_SALT=replace-with-strong-random-salt
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB (behavioral signal storage). docker-compose.yml points this at the
# bundled `mongo` service; for local (non-Docker) dev, point it at a local
# or Atlas MongoDB instance.
MONGODB_URL=mongodb://localhost:27017

# Optional: real semantic embeddings for recommendation ranking. Without
# this, the system falls back to heuristic-only scoring (see
# agents/embeddings.py).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# Optional: live web search for recommendation catalog expansion.
SERPER_API_KEY=
ENABLE_FALLBACK_WEBSEARCH=true

# Guardrails (no auth exists yet, so these protect an anonymous public API —
# see README's "Guardrails" section). Sensible defaults, all tunable without
# a code change.
ARCHE_RATE_LIMIT_EXPENSIVE=20/minute
ARCHE_RATE_LIMIT_STANDARD=60/minute
ARCHE_LLM_BUDGET_PER_MINUTE=60
ARCHE_EMBEDDING_BUDGET_PER_MINUTE=60
ARCHE_LIVE_SEARCH_BUDGET_PER_MINUTE=30
ARCHE_MAX_BODY_BYTES=1000000
